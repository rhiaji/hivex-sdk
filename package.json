{
  "name": "hivexph-sdk",
  "version": "1.2.0",
  "description": "TypeScript SDK for Hive Custom JSON: configuration, backend signing, Hive Keychain, Hive Engine token/NFT issuers, block streaming, payments and transaction reading.",
  "license": "MIT",
  "homepage": "https://hivexph-sdk-frontend.vercel.app/",
  "bugs": {
    "url": "https://github.com/rhiaji/hivexph-sdk/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "keywords": [
    "hive",
    "custom_json",
    "hive-engine",
    "keychain",
    "blockchain",
    "sdk"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {},
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@noble/secp256k1": "^3.2.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rhiaji/hivex-sdk.git",
    "directory": "package-manager"
  }
}
